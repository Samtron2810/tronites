# Copy this file to .env and fill in real values.
# Never commit the real .env file.
#
# Required in production builds — without it, the deployed app has no way
# to reach the backend (see src/services/api.js). Local `npm run dev`
# falls back to http://localhost:5000/api automatically if this is unset.

VITE_API_URL=http://localhost:5000/api
