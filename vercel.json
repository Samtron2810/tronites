{
  "redirects": [
    { "source": "/sitemap.xml", "destination": "https://api.tronites.com/sitemap.xml", "permanent": false },
    { "source": "/sitemap-static.xml", "destination": "https://api.tronites.com/sitemap-static.xml", "permanent": false },
    { "source": "/sitemap-profiles.xml", "destination": "https://api.tronites.com/sitemap-profiles.xml", "permanent": false },
    { "source": "/sitemap-posts.xml", "destination": "https://api.tronites.com/sitemap-posts.xml", "permanent": false },
    { "source": "/sitemap-hashtags.xml", "destination": "https://api.tronites.com/sitemap-hashtags.xml", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/ssr" },
    { "source": "/u/:username", "destination": "/api/ssr" },
    { "source": "/post/:id", "destination": "/api/ssr" },
    { "source": "/hashtag/:tag", "destination": "/api/ssr" },
    { "source": "/explore", "destination": "/api/ssr" },
    { "source": "/help", "destination": "/api/ssr" },
    { "source": "/tiers", "destination": "/api/ssr" },
    { "source": "/privacy", "destination": "/api/ssr" },
    { "source": "/terms", "destination": "/api/ssr" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
